# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# typescript
next-env.d.ts
*.tsbuildinfo

# vercel
.vercel

# vendored agent skills
# Installed by the skills tooling and restorable from it, so they are not part of the
# source of this project. The hooks and settings under .claude/ are tracked deliberately —
# those are ours and shape how agents work here.
.agents/
.claude/skills/
skills-lock.json

# unredacted fixture source documents
# The inbox is a staging area on your machine only: statements land here as they come
# off a bank, with real account numbers, names and balances still in them. Nothing in it
# is ever committed. Files leave by being redacted and moved up into fixtures/statements/,
# which is tracked — see fixtures/README.md.
/fixtures/statements/inbox/*
!/fixtures/statements/inbox/.gitkeep
# The same staging area for invoices (BAN-150). An invoice carries a vendor's address, a
# GSTIN and often the owner's own name, so it is redacted on the way out, not on the way in.
/fixtures/invoices/inbox/*
!/fixtures/invoices/inbox/.gitkeep
bench/out/
