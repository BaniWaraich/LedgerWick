# Copy to .env.local and fill in. Never commit .env.local.
# For an environment Vercel already holds: `vercel env pull .env.local --yes`.

# --- Database (Neon) ---------------------------------------------------------
# Use the POOLED endpoint — the host containing `-pooler`. It is PgBouncer in
# transaction mode, which is why src/db/client.ts sets `prepare: false`.
DATABASE_URL=

# --- Authentication (Auth.js + Google) ---------------------------------------
# docs/decisions/0006-authentication.md
#
# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URIs must include, per environment:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
#
# The OAuth consent screen needs the profile and email scopes ONLY. gmail.readonly
# is Restricted, is requested incrementally at mailbox-connect time by feature J,
# and must never be added to the sign-up consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
