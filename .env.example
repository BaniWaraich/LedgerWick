# Copy to .env.local and fill in. Never commit .env.local.
#
# DO NOT run `vercel env pull .env.local`. It OVERWRITES the whole file and defaults to
# the Development scope, so every variable that lives only in Production/Preview — the
# Google credentials and AUTH_SECRET among them — is silently destroyed. That has already
# happened once.
#
# To take one variable from Vercel, pull to a scratch file and copy across:
#
#   vercel env pull .env.pull-tmp --environment=production --yes
#   # copy the line you want into .env.local, then: rm .env.pull-tmp
#
# A variable marked Sensitive in Vercel pulls as an empty value by design and can only be
# filled in by hand from the provider's dashboard.

# --- Database (Neon) ---------------------------------------------------------
# Use the POOLED endpoint — the host containing `-pooler`. It is PgBouncer in
# transaction mode, which is why src/db/client.ts sets `prepare: false`.
DATABASE_URL=

# --- Authentication (Auth.js + Google) ---------------------------------------
# docs/decisions/0006-authentication.md
#
# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# One client serves both sign-in and Gmail connection. Authorised redirect URIs must
# include, per environment:
#   http://localhost:3000/api/auth/callback/google     (sign-in, Auth.js)
#   https://<your-domain>/api/auth/callback/google
#   http://localhost:3000/api/gmail/callback           (Gmail connection, feature J)
#   https://<your-domain>/api/gmail/callback
#
# Sign-in requests profile and email ONLY, and must never ask for gmail.readonly.
# gmail.readonly is Restricted; it is requested separately, incrementally, when a user
# chooses to connect a mailbox (docs/workflows/connect-gmail.md §5). It does belong in
# the consent screen's Data Access list, and the Gmail API must be enabled on the
# project -- listing a scope there is not the same as requesting it at sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail credentials (feature J) --------------------------------------------
# docs/workflows/connect-gmail.md §6
#
# The key that encrypts every stored Gmail refresh token (AES-256-GCM). 32 random
# bytes, base64-encoded:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Mark it Sensitive in Vercel. Losing it makes every stored connection unreadable
# (users must reconnect); leaking it alongside the database exposes their mail.
# Never commit a real value here.
GMAIL_TOKEN_KEY=

# --- Document storage (Vercel Blob) -------------------------------------------
# docs/decisions/0007-file-storage.md
#
# Create a Blob store, then `vercel env pull .env.local --yes`. On Vercel the SDK
# uses OIDC and this is not needed; locally it is.
#
# Blobs are written with access: "private". There is no public URL for a document
# and none is ever handed to the frontend — bytes are served only through the
# authorized routes in src/app/api.
BLOB_READ_WRITE_TOKEN=

# --- Background workflows (Inngest) -------------------------------------------
# docs/architecture.md §7
#
# The SDK defaults to CLOUD mode and refuses to serve without a signing key, so local
# development needs INNGEST_DEV=1 — without it /api/inngest returns 500 with "In cloud
# mode but no signing key found". Set it here, then run the dev server alongside the app:
#
#   npx inngest-cli@latest dev
#
# which discovers the app at http://localhost:3000/api/inngest. GET that URL to check it:
# `"mode":"dev"` and a non-zero `function_count` mean the workflows registered.
INNGEST_DEV=1
#
# Leave the two below empty locally. Both are required on Vercel, where INNGEST_DEV must
# NOT be set. Inngest dashboard → Manage → Event Keys / Signing Key.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Model inference (Vercel AI Gateway) --------------------------------------
# docs/architecture.md §21.2 defers the provider choice to evaluation, so the model is
# named by a plain "provider/model" string and can be changed without a code change.
#
# On Vercel the gateway authenticates with OIDC and this is not needed; locally it is.
AI_GATEWAY_API_KEY=
# Optional. Overrides the default in src/ai/model.ts.
AI_MODEL=
