# inngest declares @sveltejs/kit as an optional peer. npm tries to satisfy it anyway and
# lands on a vite 8 that conflicts with the vite 7 vitest pins, so a plain `npm install`
# fails ERESOLVE on a tree that contains no Svelte at all.
#
# Setting this repo-wide keeps `npm install`, `npm ci` and `npm run lock:refresh`
# resolving identically. Nothing here relies on a peer being mis-resolved; the one real
# conflict is a framework we do not use.
legacy-peer-deps=true
